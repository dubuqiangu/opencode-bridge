# 运行态 / 用户配置（绝不提交：可能含 token、密码、会话映射）
config.json
state.json
plugin/config.json
*.log
bridge-output.log
bridge-plugin.log
.bridge-plugin.lock
# 本项目自己的单实例锁（桥启动时生成，含本机 pid）
.bridge-instance.lock
# 进程诊断产物（G1 取证）：生命周期账本 + 崩溃栈，含 pid/线程栈/本机路径
bridge-lifecycle.jsonl
bridge-lifecycle.jsonl.1
bridge-stacks.log

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# 测试用的仓库内临时目录（Windows 上 tempfile 默认落到用户 Temp，
# 会触发沙箱的外部目录权限；测试统一把 TEMP/TMP 指到这里）
.tmp/

# Node / bun
node_modules/
package-lock.json

# 会话与系统文件
*.session
*.session-journal
.DS_Store
