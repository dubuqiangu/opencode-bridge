# 运行态 / 用户配置（绝不提交：可能含 token、密码、会话映射）
config.json
state.json
plugin/config.json
*.log
bridge-output.log
bridge-plugin.log
.bridge-plugin.lock
# 本项目自己的单实例锁（桥启动时生成，含本机 pid）
.bridge-instance.lock
# 进程诊断产物（G1 取证）：生命周期账本 + 崩溃栈，含 pid/线程栈/本机路径
bridge-lifecycle.jsonl
bridge-lifecycle.jsonl.1
bridge-stacks.log
# 「上次启动时各适配器的探测结论」（opencode_bridge/health.py 写的运行态记录）。
# 含平台回的错误描述 —— 已脱敏，但仍是**运行态产物**，绝不提交。
platform-health.json
# 「运行期观测到的出站发送失败」（同一模块写的**第二份**运行态记录，
# 与上面那份**各答各的**：那份答「上次启动那一刻认不认凭据」，这份答
# 「上一次发送失败是什么时候、为什么」）。含平台回的错误描述 —— detail 已脱敏，
# 但仍是**运行态产物**，绝不提交。
outbound-failures.json

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# 测试用的仓库内临时目录（Windows 上 tempfile 默认落到用户 Temp，
# 会触发沙箱的外部目录权限；测试统一把 TEMP/TMP 指到这里）
.tmp/

# Node / bun
node_modules/
package-lock.json

# 会话与系统文件
*.session
*.session-journal
.DS_Store

# G2 写前收件箱（SQLite）。**含消息正文（text 列），属隐私数据，绝不提交。**
# WAL 模式下还有两个副文件，一并忽略。
inbox.db
inbox.db-wal
inbox.db-shm
